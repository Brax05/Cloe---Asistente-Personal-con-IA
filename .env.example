# ── Spotify ────────────────────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=tu_client_id_aqui
SPOTIFY_CLIENT_SECRET=tu_client_secret_aqui
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback
# ID de la playlist para contexto inicial (opcional)
SPOTIFY_PLAYLIST_ID=

# ── Google Calendar + Gmail ────────────────────────────────────────────────────
# Ruta al credentials.json descargado de Google Cloud Console
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.pickle

# ── General y Cerebro IA (Nube Gratis 0% GPU o Ollama Local) ───────────────
TIMEZONE=America/Mexico_City

# Proveedor IA: auto (usa Groq o Gemini si hay API key, si no Ollama local), groq, gemini, ollama
CLOE_LLM_PROVIDER=auto
# API Key gratuita de Groq (https://console.groq.com/keys) -> Llama 3.3 70B a 0% GPU
GROQ_API_KEY=
CLOE_GROQ_MODEL=llama-3.3-70b-versatile
# API Key gratuita de Google Gemini (https://aistudio.google.com/apikey) -> Gemini 2.5 Flash a 0% GPU
GEMINI_API_KEY=
CLOE_GEMINI_MODEL=gemini-2.5-flash

# Solo si usas Cloe con Ollama local o desde otro PC en la red:
# OLLAMA_HOST=http://127.0.0.1:11434
CLOE_OLLAMA_MODEL=cloe

# ── Voz (opcional) ─────────────────────────────────────────────────────────────
# Modelo de Whisper: tiny, base, small, medium, large-v3
CLOE_STT_MODEL=small
# auto intenta CUDA y cae a CPU si faltan librerías
CLOE_STT_DEVICE=auto
CLOE_STT_LANGUAGE=es
# Motor de voz: piper, kokoro, espeak o none
CLOE_TTS_ENGINE=piper
# Voz de Kokoro (si usas kokoro): ef_dora (femenina), em_alex (masculino)
#CLOE_KOKORO_VOICE=ef_dora
#CLOE_KOKORO_SPEED=1.0
#CLOE_KOKORO_LANG=es
# Voces: es_MX-claude-high, es_MX-ald-medium, es_ES-davefx-medium...
# (se instalan con: python -m voice.setup_models --voice NOMBRE)
#CLOE_PIPER_VOICE=es_MX-claude-high
#CLOE_PIPER_LENGTH_SCALE=1.05
# Micrófono/altavoz específicos (PipeWire o ALSA). Vacío = predeterminado.
#CLOE_MIC_TARGET=
#CLOE_SPEAKER_TARGET=
#CLOE_VOICE_SILENCE_MS=900
# Umbral mínimo de voz (RMS en banda 300-3400 Hz)
#CLOE_VOICE_THRESHOLD=0.010
# Calibración de ruido ambiente y umbral adaptativo
#CLOE_VOICE_CALIBRATION_MS=800
#CLOE_VOICE_NOISE_MULT=2.5
#CLOE_VOICE_NOISE_SUSTAIN=1.8
#CLOE_VOICE_START_FRAMES=4
#CLOE_VOICE_PEAK_RATIO=1.5
#CLOE_VOICE_MAX_THRESHOLD=0.080
# Si el micrófono no entrega señal, revisa su volumen:
#   wpctl status
#   wpctl set-volume <ID_FUENTE> 1.0
#   amixer -c 1 sset Dmic0 60
# ¿Leer también los mensajes espontáneos de la mascota?
#CLOE_SPEAK_SOLO=false

# ── Llamadas (opcional, interfaz lista) ────────────────────────────────────────
# Proveedor de llamadas: none (desactivado), sip, webrtc, android
# La implementación concreta se registra en voice/calls.py.
#CLOE_CALL_PROVIDER=none
# Duración máxima de una llamada en segundos
#CLOE_CALL_MAX_DURATION_S=300
# Lista blanca de números permitidos, separados por coma.
# Vacío = cualquier número válido (no recomendado en producción).
#CLOE_CALL_ALLOWLIST=+5215512345678

